# Justfile for {{ project_name }}
# Run `just` to see available recipes.

# Default recipe — show help
default:
    @just --list

# ── Development ─────────────────────────────────────────────────────────────

# Install / sync dependencies
sync:
    uv sync --locked

# Resolve intentional dependency changes, then review and commit uv.lock
lock:
    uv lock

# Audit every locked extra and group; do not suppress findings without fixes
security-audit:
    uv audit --locked --no-build

# Format code with ruff
fmt:
    uv run --locked ruff format .

# Lint code with ruff
lint:
    uv run --locked ruff check .
    uv run --locked cli skills validate --all

# Format + lint
check: fmt lint

# Run tests
test:
    uv run --locked pytest tests/ -v

# Run unit tests only
test-unit:
    uv run --locked pytest tests/unit_tests/ -v

# ── Skills ───────────────────────────────────────────────────────────────────

# List all available skills
skills:
    uv run --locked cli skills list

# Add a skill by name (bundled)
add-skill name:
    uv run --locked cli skills add {{ "{{" }}name{{ "}}" }}

# Validate all skills
lint-skills:
    uv run --locked cli skills validate --all

# ── Web Interface ────────────────────────────────────────────────────────────

# Launch Streamlit webapp (entry point discovered from genai-tk package)
webapp:
    entry=$(uv run --locked python -c 'import pathlib, genai_tk; print(pathlib.Path(genai_tk.__file__).parent / "webapp/main/streamlit.py")') && uv run --locked python -m streamlit run "$entry"

# ── Project-specific ─────────────────────────────────────────────────────────

{{ project_recipes }}
