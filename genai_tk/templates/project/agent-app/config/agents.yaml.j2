# Unified Agent Profiles — all harnesses under one ``agents:`` dict.
#
# Each profile carries a ``harness:`` discriminator (``langchain`` | ``deerflow``).
# The optional ``agent_defaults:`` block holds inheritable defaults applied to
# ``harness: langchain`` profiles (DeerFlow profiles are fully self-describing).
# See docs/agents.md and docs/harness.md.

agent_defaults:
  type: react
  llm: null  # null = use the global default LLM from config
  middlewares:
    - class: genai_tk.agents.langchain.middleware.rich_middleware.RichToolCallMiddleware
  checkpointer:
    type: none
  backend:
    type: none
  enable_planning: true
  enable_file_system: true
  skills:
    directories:
      - ${paths.project}/skills/custom
      - ${paths.project}/skills/community
  default_profile: default

agents:
  default:
    harness: langchain
    name: "Default Agent"
    type: react
    llm: default
    system_prompt: >
      You are a helpful AI assistant for {{ project_name }}.
      Use available tools when they help answer the question.
    tools:
      - factory: {{ package_name }}.tools.example_tool.create_example_tools
    mcp_servers: []

  research:
    harness: langchain
    name: "Research Agent"
    type: deep
    llm: default
    enable_planning: true
    system_prompt: >
      You are a research assistant. Plan your approach, use available tools,
      and produce well-structured, cited responses.
    skill_directories:
      - ${paths.project}/skills/custom
      - ${paths.project}/skills/community
