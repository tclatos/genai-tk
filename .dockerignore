# Version control
.git
.gitignore

# Credentials must never reach the builder, even through COPY . .
**/.env
**/.env.*
**/.aws
**/.ssh
**/.codex
**/.agents
**/.npmrc
**/.pypirc
**/.netrc
**/.streamlit/secrets.toml
**/*credentials*.json
**/*.pem
**/*.key

# Python
.venv
__pycache__
*.py[cod]
*.egg-info
dist
build

# IDE
.vscode
.idea
*.swp
*.swo

# Testing & CI
.pytest_cache
.ruff_cache
.mypy_cache
.coverage
htmlcov
tests

# Documentation (not needed in image)
docs
*.md
!README.md
# Runtime skills and their referenced Markdown are application assets.
!skills/**/*.md

# Temporary files
tmp
*.log
None

# Data files (mounted at runtime)
data

# Deploy scripts (not needed inside image)
deploy/*.just
deploy/*.mk
deploy/*.sh
deploy/docker-compose.*

# Other
examples
notebooks
scripts
vendor
ext
fib.py
fibonacci.py
